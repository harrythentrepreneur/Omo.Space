{
  "artifacts": [],
  "description": "Turn verified product facts into three Facebook ad variants with distinct angles, testing notes, and compliance-safe claims.",
  "endpoint": {
    "auth": "modal_proxy_token",
    "method": "POST",
    "path": "/v1/runs",
    "poll_path_template": "/v1/runs/{call_id}"
  },
  "form": [
    {
      "field": "product_name",
      "widget": "text"
    },
    {
      "field": "offer",
      "widget": "textarea"
    },
    {
      "field": "audience",
      "widget": "textarea"
    },
    {
      "field": "objective",
      "widget": "select"
    },
    {
      "field": "tone",
      "widget": "select"
    },
    {
      "field": "proof_points",
      "widget": "textarea"
    },
    {
      "field": "constraints",
      "widget": "textarea"
    }
  ],
  "input_adapters": [],
  "input_schema": {
    "$id": "https://omo.space/schemas/facebook-ads-copywriter/input.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Verified product and campaign facts for three Facebook ad-copy variants.",
    "properties": {
      "audience": {
        "description": "The intended audience in non-sensitive, non-discriminatory terms.",
        "examples": [
          "Busy home cooks who want a reliable weeknight dinner without a long cleanup."
        ],
        "maxLength": 800,
        "minLength": 8,
        "title": "Audience",
        "type": "string"
      },
      "constraints": {
        "default": "",
        "description": "Claims, words, topics, or policy risks to avoid.",
        "examples": [
          "Do not mention weight loss or make health claims."
        ],
        "maxLength": 800,
        "title": "Constraints",
        "type": "string"
      },
      "objective": {
        "default": "sales",
        "description": "The campaign result the copy should support.",
        "enum": [
          "sales",
          "leads",
          "traffic"
        ],
        "title": "Campaign objective",
        "type": "string"
      },
      "offer": {
        "description": "The exact product, price, promotion, or action being offered. Include only currently true facts.",
        "examples": [
          "A 12-inch cast-iron skillet with a silicone handle cover and free shipping this week."
        ],
        "maxLength": 1200,
        "minLength": 8,
        "title": "Offer",
        "type": "string"
      },
      "product_name": {
        "description": "The product or service name.",
        "examples": [
          "Northstar Cast-Iron Skillet"
        ],
        "maxLength": 120,
        "minLength": 2,
        "title": "Product name",
        "type": "string"
      },
      "proof_points": {
        "description": "Verified features, evidence, testimonials, or differentiators the ads may use.",
        "examples": [
          "Pre-seasoned surface, oven-safe construction, and a removable silicone handle cover."
        ],
        "maxLength": 1600,
        "minLength": 3,
        "title": "Proof points",
        "type": "string"
      },
      "tone": {
        "default": "direct",
        "description": "The writing voice for all three variants.",
        "enum": [
          "direct",
          "playful",
          "premium",
          "warm"
        ],
        "title": "Tone",
        "type": "string"
      }
    },
    "required": [
      "product_name",
      "offer",
      "audience",
      "objective",
      "tone",
      "proof_points",
      "constraints"
    ],
    "title": "Facebook ads copy brief",
    "type": "object"
  },
  "name": "facebook-ads-copywriter",
  "output_schema": {
    "$id": "https://omo.space/schemas/facebook-ads-copywriter/output.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "ads": {
        "description": "Three complete Facebook ad-copy variants with distinct angles.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "angle": {
              "maxLength": 120,
              "minLength": 3,
              "title": "Angle",
              "type": "string"
            },
            "cta": {
              "enum": [
                "Shop Now",
                "Learn More",
                "Sign Up",
                "Get Offer"
              ],
              "title": "CTA",
              "type": "string"
            },
            "description": {
              "maxLength": 160,
              "minLength": 3,
              "title": "Description",
              "type": "string"
            },
            "headline": {
              "maxLength": 100,
              "minLength": 5,
              "title": "Headline",
              "type": "string"
            },
            "primary_text": {
              "maxLength": 1200,
              "minLength": 50,
              "title": "Primary text",
              "type": "string"
            }
          },
          "required": [
            "angle",
            "primary_text",
            "headline",
            "description",
            "cta"
          ],
          "type": "object"
        },
        "maxItems": 3,
        "minItems": 3,
        "title": "Ad variants",
        "type": "array"
      },
      "campaign_summary": {
        "maxLength": 700,
        "minLength": 20,
        "title": "Campaign summary",
        "type": "string"
      },
      "compliance_notes": {
        "items": {
          "maxLength": 360,
          "minLength": 8,
          "type": "string"
        },
        "maxItems": 6,
        "minItems": 1,
        "title": "Compliance notes",
        "type": "array"
      },
      "run_id": {
        "minLength": 8,
        "title": "Run ID",
        "type": "string"
      },
      "status": {
        "const": "completed"
      },
      "testing_notes": {
        "items": {
          "maxLength": 360,
          "minLength": 8,
          "type": "string"
        },
        "maxItems": 8,
        "minItems": 2,
        "title": "Testing notes",
        "type": "array"
      },
      "usage": {
        "additionalProperties": false,
        "properties": {
          "completion_tokens": {
            "minimum": 0,
            "type": "integer"
          },
          "estimated_cost_usd": {
            "minimum": 0,
            "type": "number"
          },
          "llm_calls": {
            "maximum": 2,
            "minimum": 1,
            "type": "integer"
          },
          "model": {
            "minLength": 1,
            "type": "string"
          },
          "prompt_tokens": {
            "minimum": 0,
            "type": "integer"
          },
          "provider": {
            "const": "opencode-go"
          }
        },
        "required": [
          "provider",
          "model",
          "llm_calls",
          "prompt_tokens",
          "completion_tokens",
          "estimated_cost_usd"
        ],
        "title": "Provider usage",
        "type": "object"
      },
      "workflow_version": {
        "const": "facebook-ads-copywriter@0.1.0"
      }
    },
    "required": [
      "run_id",
      "status",
      "workflow_version",
      "campaign_summary",
      "ads",
      "testing_notes",
      "compliance_notes",
      "usage"
    ],
    "title": "Completed Facebook ads copy package",
    "type": "object"
  },
  "output_schema_path": "schemas/output.json",
  "pricing": {
    "chargeable": true,
    "currency": "USD",
    "display_price_usd": 0.1,
    "label": "$0.10 per run",
    "quote_status": "cost_model",
    "report_path": "pricing-report.json"
  },
  "profile_sha256": "64bec90161a977dda727e7f44e6fef91836235d32f9a551f402cae55f8926a61",
  "readiness": {
    "blockers": [],
    "can_submit": true,
    "required_env_names": [
      "LLM_API_KEY",
      "LLM_BASE_URL",
      "LLM_MODEL"
    ],
    "status": "ready"
  },
  "schema_version": "cognition.workflow-manifest/v1",
  "slug": "facebook-ads-copywriter",
  "source_sha256": "4b7031309819a929130648c55fd16a38a8dce779998f696364817ef0a35b075e",
  "version": "0.1.0"
}
