{
  "$id": "https://omo.space/schemas/facebook-ads-copywriter/output.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ads": {
      "description": "Three complete Facebook ad-copy variants with distinct angles.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "angle": {
            "maxLength": 120,
            "minLength": 3,
            "title": "Angle",
            "type": "string"
          },
          "cta": {
            "enum": [
              "Shop Now",
              "Learn More",
              "Sign Up",
              "Get Offer"
            ],
            "title": "CTA",
            "type": "string"
          },
          "description": {
            "maxLength": 160,
            "minLength": 3,
            "title": "Description",
            "type": "string"
          },
          "headline": {
            "maxLength": 100,
            "minLength": 5,
            "title": "Headline",
            "type": "string"
          },
          "primary_text": {
            "maxLength": 1200,
            "minLength": 50,
            "title": "Primary text",
            "type": "string"
          }
        },
        "required": [
          "angle",
          "primary_text",
          "headline",
          "description",
          "cta"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Ad variants",
      "type": "array"
    },
    "campaign_summary": {
      "maxLength": 700,
      "minLength": 20,
      "title": "Campaign summary",
      "type": "string"
    },
    "compliance_notes": {
      "items": {
        "maxLength": 360,
        "minLength": 8,
        "type": "string"
      },
      "maxItems": 6,
      "minItems": 1,
      "title": "Compliance notes",
      "type": "array"
    },
    "run_id": {
      "minLength": 8,
      "title": "Run ID",
      "type": "string"
    },
    "status": {
      "const": "completed"
    },
    "testing_notes": {
      "items": {
        "maxLength": 360,
        "minLength": 8,
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 2,
      "title": "Testing notes",
      "type": "array"
    },
    "usage": {
      "additionalProperties": false,
      "properties": {
        "completion_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "estimated_cost_usd": {
          "minimum": 0,
          "type": "number"
        },
        "llm_calls": {
          "const": 1
        },
        "model": {
          "minLength": 1,
          "type": "string"
        },
        "prompt_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "provider": {
          "const": "opencode-go"
        }
      },
      "required": [
        "provider",
        "model",
        "llm_calls",
        "prompt_tokens",
        "completion_tokens",
        "estimated_cost_usd"
      ],
      "title": "Provider usage",
      "type": "object"
    },
    "workflow_version": {
      "const": "facebook-ads-copywriter@0.1.0"
    }
  },
  "required": [
    "run_id",
    "status",
    "workflow_version",
    "campaign_summary",
    "ads",
    "testing_notes",
    "compliance_notes",
    "usage"
  ],
  "title": "Completed Facebook ads copy package",
  "type": "object"
}
