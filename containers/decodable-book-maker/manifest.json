{
  "artifacts": [
    {
      "cover_colors": {
        "classic": "#3E6B8F",
        "playful": "#E8643B",
        "warm": "#B45F4A"
      },
      "filename": "decodable-book.pdf",
      "footer": "PhonicsMaker | A decodable reading book",
      "signed_url_ttl_seconds": 3600,
      "signing_key_env": "LLM_API_KEY",
      "subtitle": "A stage-safe story for early readers",
      "type": "book_pdf",
      "volume_name": "omo-decodable-book-artifacts"
    }
  ],
  "description": "Make a reviewed en-US decodable phonics story and deliver it as a multi-page PDF book.",
  "endpoint": {
    "auth": "modal_proxy_token",
    "method": "POST",
    "path": "/v1/runs",
    "poll_path_template": "/v1/runs/{call_id}"
  },
  "form": [
    {
      "field": "phonics_stage",
      "widget": "select"
    },
    {
      "field": "theme",
      "widget": "textarea"
    },
    {
      "field": "child_name",
      "widget": "text"
    }
  ],
  "input_adapters": [],
  "input_schema": {
    "$id": "https://omo.space/schemas/decodable-book-maker/input.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Select one reviewed cumulative phonics stage, give a bounded theme as inspiration, and optionally a child's name as the sole special-word exception.",
    "properties": {
      "child_name": {
        "description": "Optional. A child's name; the sole special-word exception and counted separately from decodable and sight words.",
        "examples": [
          "Sam"
        ],
        "maxLength": 40,
        "minLength": 1,
        "title": "Child's name (optional)",
        "type": "string"
      },
      "phonics_stage": {
        "description": "The reviewed cumulative phonics stage the whole book must stay within.",
        "enum": [
          "short-a-cvc",
          "short-a-plus-short-i-cvc",
          "short-a-i-o-cvc",
          "mixed-short-vowel-cvc",
          "mixed-cvc-plus-common-digraphs"
        ],
        "title": "Phonics stage",
        "type": "string"
      },
      "theme": {
        "description": "Inspiration for the plot, not permission to introduce vocabulary beyond the selected stage. Very early stages may adapt it to a fluent stage-safe motif.",
        "examples": [
          "A cat and a hat"
        ],
        "maxLength": 160,
        "minLength": 3,
        "title": "Theme",
        "type": "string"
      }
    },
    "required": [
      "phonics_stage",
      "theme"
    ],
    "title": "Decodable book brief",
    "type": "object"
  },
  "name": "decodable-book-maker",
  "output_schema": {
    "$id": "https://omo.space/schemas/decodable-book-maker/output.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "artifact": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 1,
            "type": "integer"
          },
          "content_type": {
            "const": "application/pdf"
          },
          "filename": {
            "maxLength": 160,
            "minLength": 5,
            "pattern": "^[^/]+\\.pdf$",
            "type": "string"
          },
          "kind": {
            "const": "pdf"
          },
          "object_key": {
            "maxLength": 320,
            "minLength": 16,
            "type": "string"
          },
          "page_count": {
            "minimum": 1,
            "type": "integer"
          },
          "role": {
            "const": "book"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "role",
          "object_key",
          "filename",
          "content_type",
          "bytes",
          "sha256",
          "page_count"
        ],
        "type": "object"
      },
      "artifact_url": {
        "description": "Short-lived signed download URL for the finished PDF.",
        "maxLength": 1000,
        "minLength": 16,
        "type": "string"
      },
      "book": {
        "description": "The stage-safe story in Markdown with at least three sections.",
        "maxLength": 12000,
        "minLength": 120,
        "title": "Story book",
        "type": "string"
      },
      "decodability": {
        "additionalProperties": false,
        "properties": {
          "dialect": {
            "const": "en-US"
          },
          "name_occurrences": {
            "minimum": 0,
            "type": "integer"
          },
          "review_words": {
            "items": {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "sight_words": {
            "items": {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "stage": {
            "enum": [
              "short-a-cvc",
              "short-a-plus-short-i-cvc",
              "short-a-i-o-cvc",
              "mixed-short-vowel-cvc",
              "mixed-cvc-plus-common-digraphs"
            ]
          },
          "within_stage_percent": {
            "maximum": 100,
            "minimum": 0,
            "type": "number"
          },
          "word_counts": {
            "additionalProperties": false,
            "properties": {
              "decodable": {
                "minimum": 0,
                "type": "integer"
              },
              "review": {
                "minimum": 0,
                "type": "integer"
              },
              "sight": {
                "minimum": 0,
                "type": "integer"
              },
              "total": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "total",
              "decodable",
              "sight",
              "review"
            ],
            "type": "object"
          }
        },
        "required": [
          "dialect",
          "stage",
          "word_counts",
          "sight_words",
          "name_occurrences",
          "within_stage_percent",
          "review_words"
        ],
        "title": "Deterministic decodability report",
        "type": "object"
      },
      "page_plan": {
        "description": "The PDF-ready page sequence.",
        "items": {
          "maxLength": 360,
          "minLength": 8,
          "type": "string"
        },
        "maxItems": 14,
        "minItems": 3,
        "title": "Page plan",
        "type": "array"
      },
      "run_id": {
        "minLength": 8,
        "title": "Run ID",
        "type": "string"
      },
      "status": {
        "const": "completed"
      },
      "title": {
        "maxLength": 120,
        "minLength": 3,
        "title": "Book title",
        "type": "string"
      },
      "usage": {
        "additionalProperties": false,
        "properties": {
          "completion_tokens": {
            "minimum": 0,
            "type": "integer"
          },
          "estimated_cost_usd": {
            "minimum": 0,
            "type": "number"
          },
          "llm_calls": {
            "maximum": 2,
            "minimum": 1,
            "type": "integer"
          },
          "model": {
            "minLength": 1,
            "type": "string"
          },
          "prompt_tokens": {
            "minimum": 0,
            "type": "integer"
          },
          "provider": {
            "const": "opencode-go"
          }
        },
        "required": [
          "provider",
          "model",
          "llm_calls",
          "prompt_tokens",
          "completion_tokens",
          "estimated_cost_usd"
        ],
        "title": "Provider usage",
        "type": "object"
      },
      "workflow_version": {
        "const": "decodable-book-maker@1.0.0"
      }
    },
    "required": [
      "run_id",
      "status",
      "workflow_version",
      "title",
      "book",
      "page_plan",
      "decodability",
      "artifact",
      "artifact_url",
      "usage"
    ],
    "title": "Completed decodable PDF book",
    "type": "object"
  },
  "output_schema_path": "schemas/output.json",
  "pricing": {
    "chargeable": false,
    "currency": "USD",
    "display_price_usd": 0.1,
    "label": "Projected $0.10 — unavailable",
    "quote_status": "modeled",
    "report_path": "pricing-report.json"
  },
  "readiness": {
    "blockers": [
      {
        "code": "DECODABILITY_VOCABULARY_MISSING",
        "detail": "The reviewed OSS contract requires every child-visible word to pass a compiler-owned stage vocabulary plus a reviewed sight-word list, recomputed deterministically, and a runnable result must contain no review words. No such vocabulary resource exists in this repo or in the OSS twin (which publishes only SKILL.md, manifest.json, README, LICENSE), and the compiler has no vocabulary-based normalizer kind for whole-book enforcement. Resume: author the five cumulative stage vocabularies + reviewed sight-word list from PhonicsMaker's reviewed inventory (or Harry supplies them), add a deterministic vocabulary normalizer to the runtime template, fixture-test right/wrong needles, then flip can_submit. The paper price ($0.99) and schemas are reviewed and stay fixed."
      }
    ],
    "can_submit": false,
    "required_env_names": [
      "LLM_API_KEY",
      "LLM_BASE_URL",
      "LLM_MODEL"
    ],
    "status": "not_ready"
  },
  "schema_version": "cognition.workflow-manifest/v1",
  "slug": "decodable-book-maker",
  "source_sha256": "d01ae61d577c1555b1b32761b15ea7c08c4c5fe1203756d18132a77bcb8785d7",
  "version": "1.0.0"
}
