{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognition.marketplace/schemas/claude-seo-skill/output.json",
  "title": "Claude SEO Skill audit result",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "quick_wins", "summary"],
  "properties": {
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "fix", "priority"],
        "properties": {
          "issue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "pattern": "\\S"
          },
          "fix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        }
      }
    },
    "quick_wins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400,
        "pattern": "\\S"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    }
  }
}
