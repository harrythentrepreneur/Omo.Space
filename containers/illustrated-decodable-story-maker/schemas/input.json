{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "art_style": {
      "enum": [
        "2d",
        "watercolor",
        "paper-cut"
      ]
    },
    "curriculum": {
      "enum": [
        "general",
        "vic",
        "sg_moe",
        "us_ccss"
      ]
    },
    "difficulty_level": {
      "enum": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6"
      ]
    },
    "highlight_text": {
      "type": "boolean"
    },
    "language_variant": {
      "enum": [
        "en_au",
        "en_uk",
        "en_us",
        "fr"
      ]
    },
    "page_count": {
      "maximum": 21,
      "minimum": 7,
      "type": "integer"
    },
    "phonemes": {
      "items": {
        "maxLength": 20,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "printable": {
      "type": "boolean"
    },
    "progressive_highlighting": {
      "type": "boolean"
    },
    "story_idea": {
      "maxLength": 500,
      "minLength": 3,
      "type": "string"
    }
  },
  "required": [
    "phonemes",
    "story_idea",
    "difficulty_level",
    "language_variant",
    "curriculum",
    "page_count",
    "highlight_text",
    "progressive_highlighting",
    "printable",
    "art_style"
  ],
  "type": "object"
}
