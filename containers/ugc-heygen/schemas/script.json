{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognition.marketplace/schemas/ugc-heygen/script.json",
  "title": "UGC script",
  "type": "object",
  "additionalProperties": false,
  "required": ["hook", "lines", "cta"],
  "properties": {
    "hook": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "cta": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
