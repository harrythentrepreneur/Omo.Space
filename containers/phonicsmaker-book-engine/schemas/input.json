{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhonicsMaker source-compatible book input",
  "type": "object",
  "additionalProperties": false,
  "required": ["phonemes", "story_idea", "difficulty_level"],
  "properties": {
    "phonemes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "story_idea": {"type": "string", "minLength": 1},
    "difficulty_level": {"type": "string", "minLength": 1},
    "language_variant": {"type": "string"},
    "curriculum": {"type": "string"},
    "year_level": {"type": "string"},
    "student_age": {"type": ["string", "integer", "number"]},
    "vocabulary_mode": {"type": "string"},
    "focus_mode": {"type": "string"},
    "known_phonemes": {"type": "array", "items": {"type": "string"}},
    "focus_phonemes": {"type": "array", "items": {"type": "string"}},
    "sight_words": {"type": "array", "items": {"type": "string"}},
    "strict_decodable": {"type": "boolean"},
    "morphology_focus": {"type": "array", "items": {"type": "string"}},
    "story_format": {"type": "string"},
    "highlight_text": {"type": "boolean"},
    "illustration_style": {"type": "string"},
    "story_type": {"type": "string"},
    "book_layout": {"type": "string"},
    "book_font": {"type": "string"},
    "page_count": {"type": "integer"},
    "include_activities": {"type": "boolean"},
    "activity_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_word_hunt": {"type": "boolean"},
        "include_sound_matching": {"type": "boolean"},
        "include_fill_in_blank": {"type": "boolean"},
        "include_tracing": {"type": "boolean"},
        "include_circle_sound": {"type": "boolean"},
        "include_word_scramble": {"type": "boolean"},
        "include_cut_and_sort": {"type": "boolean"},
        "include_sentence_building": {"type": "boolean"},
        "include_phoneme_spotter": {"type": "boolean"},
        "include_rhyming_pairs": {"type": "boolean"},
        "include_phoneme_position": {"type": "boolean"},
        "include_sound_swap": {"type": "boolean"},
        "include_syllable_count": {"type": "boolean"},
        "include_word_ladder": {"type": "boolean"},
        "include_read_and_draw": {"type": "boolean"},
        "include_phoneme_count": {"type": "boolean"},
        "include_odd_one_out": {"type": "boolean"},
        "include_missing_sound": {"type": "boolean"},
        "include_real_or_nonsense": {"type": "boolean"},
        "include_word_building": {"type": "boolean"},
        "include_crossword": {"type": "boolean"},
        "include_comprehension_questions": {"type": "boolean"},
        "include_vocabulary_building": {"type": "boolean"},
        "include_synonyms": {"type": "boolean"},
        "include_inferred_meaning": {"type": "boolean"}
      }
    },
    "series_info": {"type": "object"},
    "book_title": {"type": "string"},
    "series_characters": {"type": "array"},
    "series_theme": {"type": "string"},
    "character_pronouns": {"type": "string"},
    "reference_task_id": {"type": "string"},
    "reference_character_description": {"type": "string"},
    "reference_seed": {"type": "integer"}
  }
}
