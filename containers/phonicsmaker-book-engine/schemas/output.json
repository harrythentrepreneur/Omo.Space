{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhonicsMaker source-compatible book output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "status", "workflow_version", "task_id",
    "pdf_url", "pdf_compressed_url", "thumbnail_url", "book_only_url",
    "worksheets_url", "homework_url", "answer_key_url", "pptx_url",
    "variations", "scenes", "phonemes", "audio_manifest", "draft_data",
    "artifacts", "usage"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 8},
    "status": {"const": "completed"},
    "workflow_version": {"type": "string", "minLength": 5},
    "task_id": {"type": "string", "minLength": 1},
    "pdf_url": {"type": ["string", "null"]},
    "pdf_compressed_url": {"type": ["string", "null"]},
    "thumbnail_url": {"type": ["string", "null"]},
    "book_only_url": {"type": ["string", "null"]},
    "worksheets_url": {"type": ["string", "null"]},
    "homework_url": {"type": ["string", "null"]},
    "answer_key_url": {"type": ["string", "null"]},
    "pptx_url": {"type": ["string", "null"]},
    "variations": {"type": ["object", "null"]},
    "scenes": {"type": ["array", "null"]},
    "phonemes": {"type": ["array", "null"]},
    "audio_manifest": {"type": ["object", "null"]},
    "draft_data": {"type": ["object", "null"]},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "kind", "filename", "content_type", "bytes", "sha256", "url"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "kind": {"enum": ["pdf", "image", "pptx", "json", "audio"]},
          "filename": {"type": "string", "minLength": 1},
          "content_type": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "url": {"type": "string", "minLength": 1}
        }
      }
    },
    "usage": {"type": "object"}
  }
}
