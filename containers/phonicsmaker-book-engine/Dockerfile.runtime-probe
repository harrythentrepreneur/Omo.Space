FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    PYTHONPATH=/opt/phonicsmaker \
    PYTHONUNBUFFERED=1 \
    ENVIRONMENT=production \
    LOCAL_MODE=true \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1

WORKDIR /opt/phonicsmaker

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc ffmpeg curl build-essential libpq-dev \
    libpango-1.0-0 libpangocairo-1.0-0 libpangoft2-1.0-0 \
    libcairo2 libcairo2-dev libgdk-pixbuf-2.0-0 libffi-dev \
    libglib2.0-0 libgl1 libglib2.0-dev shared-mime-info \
    fonts-dejavu-core fontconfig \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

COPY packages/phonicsmaker-runtime/source/core/pyproject.toml packages/phonicsmaker-runtime/source/core/poetry.lock ./
RUN python -m pip install --no-cache-dir poetry==2.1.3 \
    && poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi --only main

COPY packages/phonicsmaker-runtime/source/core/ ./
RUN mkdir -p /usr/share/fonts/truetype/phonicsmaker \
    && cp static/fonts/*.ttf /usr/share/fonts/truetype/phonicsmaker/ \
    && fc-cache -f \
    && python -m compileall -q app modal_app.py runpod_handler.py runpod_wrapper.py

COPY containers/phonicsmaker-book-engine/book_adapter.py /opt/omo/book_adapter.py
COPY containers/phonicsmaker-book-engine/engine_binding.py /opt/omo/engine_binding.py
COPY containers/phonicsmaker-book-engine/source_draft_probe.py /opt/omo/source_draft_probe.py
COPY containers/phonicsmaker-book-engine/schemas /opt/omo/schemas

CMD ["python", "-c", "import app.phonics_maker.tasks.story_tasks"]
