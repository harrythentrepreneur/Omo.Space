{
  "catalog": {
    "category": "content",
    "cover": "covers/woven-relationship-book-maker.svg",
    "demoCap": "Hosted run: WhatsApp ZIP or story fields to a PDF keepsake",
    "desc": "Upload a WhatsApp export ZIP or share your story fields directly. Woven derives a factual relationship brief, writes a warm chaptered story, and delivers a beautiful PDF keepsake for $0.40. Markdown and the page plan remain available; unparseable or oversized ZIPs fail with a typed blocker.",
    "emoji": "💞",
    "exampleIn": "We met after reaching for the same book at a rainy-day shop · seven years, two cities, and one badly behaved corgi · warm and playful · short",
    "exampleOut": [
      "A warm chaptered story that carries the rainy bookshop meeting through seven years together",
      "A PDF-ready page plan with chapter breaks, memory prompts, and the corgi joke woven through"
    ],
    "free": false,
    "icon": null,
    "inputs": [
      "chat_zip: a WhatsApp export ZIP, instead of the story fields below",
      "how_you_met: a line about how you met",
      "favorite_moments: milestones and memories you want included",
      "inside_jokes: favorite jokes, phrases, and tiny details",
      "style: warm, playful, or poetic",
      "length: short or long"
    ],
    "maker": "Woven",
    "makerName": "Woven Studio",
    "name": "Woven Relationship Book Maker",
    "niche": "copy",
    "outputs": [
      "artifact_url — a signed link to the beautiful PDF keepsake book",
      "book — the chaptered relationship story in Markdown",
      "page_plan — the keepsake page plan retained in the result"
    ],
    "priceMaintain": 8.0,
    "priceOwn": 29.0,
    "promise": "Turn your love story into a beautiful keepsake book.",
    "runManifest": "run-manifests/woven-relationship-book-maker.json",
    "runPrice": 0.4,
    "slug": "woven-relationship-book-maker",
    "tags": [
      "books",
      "copy",
      "relationship",
      "story",
      "storytelling",
      "personalized",
      "love"
    ],
    "upvotes": 84,
    "version": "v1.0.0 · 2026-08-11",
    "workflow": {
      "steps": [
        {
          "label": "Parse WhatsApp export and derive the reviewed story fields",
          "role": "whatsapp_zip",
          "type": "pipeline"
        },
        {
          "max_output": 2200,
          "model": "deepseek-v4-flash",
          "role": "draft",
          "system": "You are Woven's keepsake story editor. Use only facts in the supplied JSON. Never invent names, dates, events, dialogue, quotations, or motivations. Preserve actor/action attribution exactly and preserve temporal status: never turn a plan, wish, or future event into something that already happened. Omit an ambiguous detail instead of inferring it. Write a warm relationship keepsake with a clear beginning, middle, and hopeful close in the requested style and length. Weave supplied phrases and inside jokes naturally. Return exactly one JSON object with keys title (string), book (Markdown string), and page_plan (array of 4–14 concise strings). A short book should have roughly three Markdown chapters; a long book roughly six. The book must be at least 240 characters. Do not include markdown fences or commentary outside the JSON object.",
          "type": "llm"
        },
        {
          "label": "Writing and polishing your story",
          "role": "running",
          "type": "pipeline"
        },
        {
          "label": "Render, persist, and sign the beautiful PDF keepsake",
          "role": "render_book_pdf",
          "type": "pipeline"
        }
      ]
    }
  },
