{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "grouped": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "initial_sound": {
            "maxLength": 24,
            "minLength": 1,
            "type": "string"
          },
          "items": {
            "items": {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 24,
            "minItems": 1,
            "type": "array"
          },
          "label": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "label",
          "initial_sound",
          "items"
        ],
        "type": "object"
      },
      "maxItems": 24,
      "minItems": 1,
      "type": "array"
    },
    "run_id": {
      "minLength": 8,
      "type": "string"
    },
    "status": {
      "const": "completed"
    },
    "usage": {
      "additionalProperties": false,
      "properties": {
        "completion_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "estimated_cost_usd": {
          "minimum": 0,
          "type": "number"
        },
        "llm_calls": {
          "maximum": 2,
          "minimum": 1,
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "type": "string"
        },
        "prompt_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "provider": {
          "const": "opencode-go"
        }
      },
      "required": [
        "provider",
        "model",
        "llm_calls",
        "prompt_tokens",
        "completion_tokens",
        "estimated_cost_usd"
      ],
      "type": "object"
    },
    "warnings": {
      "items": {
        "maxLength": 240,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "type": "array"
    },
    "workflow_version": {
      "const": "initial-sound-sorter@0.1.0"
    }
  },
  "required": [
    "run_id",
    "status",
    "workflow_version",
    "grouped",
    "warnings",
    "usage"
  ],
  "type": "object"
}
