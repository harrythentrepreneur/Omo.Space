{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "maxItems": 3,
      "minItems": 2,
      "type": "array"
    },
    "new_version": {
      "type": "string"
    },
    "operations_applied": {
      "type": "array"
    },
    "qa": {
      "type": "object"
    },
    "run_id": {
      "minLength": 8,
      "type": "string"
    },
    "source_version": {
      "type": "string"
    },
    "status": {
      "const": "completed"
    },
    "usage": {
      "type": "object"
    },
    "workflow_version": {
      "const": "phonics-story-edit-studio@0.1.0"
    }
  },
  "required": [
    "run_id",
    "source_version",
    "new_version",
    "status",
    "workflow_version",
    "operations_applied",
    "artifacts",
    "qa",
    "usage"
  ],
  "type": "object"
}
