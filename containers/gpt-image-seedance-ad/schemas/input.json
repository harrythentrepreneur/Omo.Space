{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognition.marketplace/schemas/gpt-image-seedance-ad/input.json",
  "title": "Cinematic product ad run input",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_description", "style_hint", "aspect"],
  "properties": {
    "product_description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "style_hint": {
      "type": "string",
      "enum": ["cinematic", "clean", "bold", "funny", "premium"]
    },
    "aspect": {
      "type": "string",
      "enum": ["9:16", "1:1", "16:9"]
    }
  }
}
