{
  "$id": "https://omo.space/schemas/phonics-list-generator/input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dialect": {
      "enum": [
        "en-US",
        "en-GB",
        "en-AU"
      ]
    },
    "difficulty_level": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "phonemes": {
      "items": {
        "maxLength": 20,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "topic": {
      "maxLength": 120,
      "type": "string"
    },
    "word_count": {
      "maximum": 30,
      "minimum": 5,
      "type": "integer"
    }
  },
  "required": [
    "phonemes",
    "topic",
    "difficulty_level",
    "dialect",
    "word_count"
  ],
  "type": "object"
}
