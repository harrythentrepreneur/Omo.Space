{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "final_count": {
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
    },
    "original_count": {
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
    },
    "sorted_words": {
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    },
    "status": {
      "const": "completed"
    }
  },
  "required": [
    "status",
    "original_count",
    "final_count",
    "sorted_words"
  ],
  "type": "object"
}
