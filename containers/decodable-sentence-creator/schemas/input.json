{
  "$id": "https://omo.space/schemas/decodable-sentence-creator/input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dialect": {
      "enum": [
        "en-US",
        "en-GB",
        "en-AU"
      ]
    },
    "include_sight_words": {
      "type": "boolean"
    },
    "num_sentences": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    },
    "phonics_patterns": {
      "items": {
        "enum": [
          "cvc",
          "cvcc",
          "ccvc",
          "long_a",
          "long_e",
          "long_i",
          "long_o",
          "long_u",
          "sh_digraph",
          "ch_digraph",
          "th_digraph",
          "wh_digraph",
          "ck_digraph",
          "ai_vowel_team",
          "ee_vowel_team",
          "oa_vowel_team"
        ]
      },
      "maxItems": 6,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "sentence_length": {
      "enum": [
        "short",
        "medium",
        "long"
      ]
    }
  },
  "required": [
    "phonics_patterns",
    "num_sentences",
    "sentence_length",
    "include_sight_words",
    "dialect"
  ],
  "type": "object"
}
