{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omo.space/schemas/education-artifact-render-manifest-v1.json",
  "title": "Omo education artifact render manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "omo.education-artifact-manifest/v1"},
    "workflow_slug": {"enum": ["phonics-worksheet-generator", "illustrated-decodable-story-maker", "phonics-story-edit-studio"]},
    "document_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "filename_stem": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]{0,99}$"},
    "phonemes": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 20}},
    "highlight_text": {"type": "boolean"},
    "highlight_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "include_answer_key": {"type": "boolean"},
    "metadata": {"type": "object"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page_number": {"type": "integer", "minimum": 1},
          "heading": {"type": "string", "maxLength": 200},
          "body": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 4000}},
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "minLength": 1, "maxLength": 80},
                "prompt": {"type": "string", "minLength": 1, "maxLength": 1000},
                "answer": {"type": "string", "maxLength": 1000},
                "accepted_answers": {"type": "array", "items": {"type": "string", "maxLength": 200}},
                "choices": {"type": "array", "items": {"type": "string", "maxLength": 200}}
              },
              "required": ["id", "prompt"]
            }
          },
          "image_path": {"type": "string", "minLength": 1},
          "image_prompt": {"type": "string", "maxLength": 2000},
          "text_style": {"type": "object"},
          "text_position": {"type": "object"}
        },
        "required": ["page_number"]
      }
    }
  },
  "required": ["schema_version", "workflow_slug", "document_id", "title", "filename_stem", "pages"]
}
