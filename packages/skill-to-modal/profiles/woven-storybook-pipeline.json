    "chargeable": false,
    "default_tier": "natural_book",
    "estimates": [
      {
        "guard_cost_usd": 0.08,
        "notes": [
          "The modeled 13-call fixture is guarded up to the source-observed $0.08 high end for a real 24k-message chat."
        ],
        "tier": "natural_book",
        "workflow": {
          "steps": [
            {"estimated_input_tokens": 15000, "max_output_tokens": 4000, "model": "deepseek-v4-flash", "role": "analysis", "type": "llm"},
            {"estimated_input_tokens": 20000, "max_output_tokens": 5000, "model": "deepseek-v4-flash", "role": "essence", "type": "llm"},
            {"estimated_input_tokens": 20000, "max_output_tokens": 10000, "model": "deepseek-v4-flash", "role": "plan", "type": "llm"},
            {"estimated_input_tokens": 8000, "max_output_tokens": 6000, "model": "deepseek-v4-flash", "qty": 8, "role": "chapter", "type": "llm"},
            {"estimated_input_tokens": 25000, "max_output_tokens": 8000, "model": "deepseek-v4-flash", "qty": 2, "role": "editorial", "type": "llm"}
