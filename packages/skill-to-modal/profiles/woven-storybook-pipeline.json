            "contains": {"properties": {"kind": {"const": "storybook_pdf"}}, "required": ["kind"]},
            "maxContains": 1,
            "minContains": 1
          },
          {
            "contains": {"properties": {"kind": {"const": "storybook_html"}}, "required": ["kind"]},
            "maxContains": 1,
            "minContains": 1
