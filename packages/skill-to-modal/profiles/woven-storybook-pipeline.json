  "input_schema": {
    "$id": "https://cognition.marketplace/schemas/woven-storybook-pipeline/input.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "chat_export": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "maximum": 52428800,
            "minimum": 1,
            "type": "integer"
          },
          "content_type": {
            "enum": [
              "text/plain",
              "application/zip"
            ],
            "type": "string"
          },
          "object_key": {
            "maxLength": 512,
            "minLength": 3,
            "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]+$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "object_key",
          "sha256",
          "bytes",
          "content_type"
        ],
        "type": "object"
      },
      "mode": {
        "const": "natural"
      },
      "pseudonymize_names": {
        "const": false
      },
      "title_override": {
        "maxLength": 120,
        "minLength": 3,
        "type": "string"
      }
    },
    "required": [
      "chat_export",
      "mode",
      "pseudonymize_names"
    ],
    "title": "Woven storybook run input",
    "type": "object"
  },
  "name": "woven-storybook-pipeline",
  "negative_cases": [
    {
      "id": "missing-chat-export",
      "input": {
        "mode": "natural",
        "pseudonymize_names": false
      },
      "reason": "chat_export is required"
    },
    {
      "id": "pseudonymization-conflicts-with-source",
      "input": {
        "chat_export": {
          "bytes": 10,
          "content_type": "text/plain",
          "object_key": "a/chat.txt",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "mode": "natural",
        "pseudonymize_names": true
      },
      "reason": "the source contract fixes real names"
    },
    {
      "id": "unsupported-mode",
      "input": {
        "chat_export": {
          "bytes": 10,
          "content_type": "text/plain",
          "object_key": "a/chat.txt",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "mode": "fixed-pages",
        "pseudonymize_names": false
      },
      "reason": "natural mode is the reviewed contract"
    },
    {
      "id": "oversized-export",
      "input": {
        "chat_export": {
          "bytes": 52428801,
          "content_type": "application/zip",
          "object_key": "a/chat.zip",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "mode": "natural",
        "pseudonymize_names": false
      },
      "reason": "input size is bounded before processing"
    },
    {
      "id": "raw-chat-field-forbidden",
      "input": {
        "chat_export": {
          "bytes": 10,
          "content_type": "text/plain",
          "object_key": "a/chat.txt",
          "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "mode": "natural",
        "pseudonymize_names": false,
        "raw_messages": [
          "never place raw chat in JSON"
        ]
      },
      "reason": "raw chat bodies are artifact-only and unknown fields fail closed"
    }
  ],
  "output_schema": {
    "$id": "https://cognition.marketplace/schemas/woven-storybook-pipeline/output.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
