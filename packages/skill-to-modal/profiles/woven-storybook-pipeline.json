{
  "apt_packages": [
    "chromium",
    "ghostscript"
  ],
  "artifacts": [
    {
      "content_type": "application/pdf",
      "kind": "storybook_pdf",
      "required": true
    },
    {
      "content_type": "text/html",
      "kind": "storybook_html",
      "required": true
    },
    {
      "content_type": "application/json",
      "kind": "quality_manifest",
      "required": true
    }
  ],
  "capabilities": [
    "private-chat-artifact-read",
    "private-book-artifact-write",
    "woven-typescript-backend",
    "deepseek-openai-compatible",
    "parallel-chapter-generation-6",
    "headless-chromium-pdf",
    "ghostscript-pdf"
  ],
  "cost_drivers": [
    "13-29 DeepSeek V4 Flash calls with chapter concurrency 5-6",
    "Archive size controls prompt volume, retries, chapter count, and 80-160 content beats",
    "Two whole-book editorial passes can use up to 16k output tokens each",
    "Chromium/Ghostscript render compute plus private artifact storage and egress are unpriced"
  ],
  "execution_kind": "complex_external",
  "form": [
    {
      "field": "chat_export",
      "widget": "private_artifact_upload"
    },
    {
      "field": "mode",
      "value": "natural",
      "widget": "hidden"
    },
    {
      "field": "pseudonymize_names",
      "value": false,
      "widget": "hidden"
    },
    {
      "field": "title_override",
      "widget": "text"
    }
  ],
  "happy_path": {
    "input": {
      "chat_export": {
        "bytes": 64000,
        "content_type": "text/plain",
        "object_key": "fixtures/chats/demo-chat.txt",
        "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "mode": "natural",
      "pseudonymize_names": false,
      "title_override": "Alex & Sam: Our Story"
