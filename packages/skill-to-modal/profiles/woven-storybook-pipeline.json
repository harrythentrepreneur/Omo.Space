      "It remains non-chargeable until Modal/render/storage cost evidence and the private data plane exist."
    ],
    "quote_status": "provisional_blocked",
    "unpriced_costs": [
      "Modal CPU and memory",
      "Chromium and Ghostscript render",
      "private artifact storage and egress",
      "failed/retried accepted-output cohort"
    ]
  },
  "prompts": {
    "chapter.txt": "Write only evidence-backed beats under the immutable continuity contract and role sentence bands. Quote pages must copy source message bytes exactly. Return sparse claim-ledger rows only for interpretation, symbolism, or ambiguity. Return strict JSON only.",
    "editorial.txt": "Audit the whole book sparsely. Preserve every per-page issue and report semanticIssueCount honestly; never reset it. Do not invent dialogue, evidence IDs, facts, or symbols. Return strict JSON only.",
    "essence.txt": "Derive the core message, two primary symbols, and one to three secondary symbols from recurrence evidence and disconfirming samples. Never impose a theme or fabricate a quote. Return strict JSON only.",
    "plan.txt": "Plan 8-16 chapters and 80-160 evidence-linked beats across scene, quote, milestone, and punch roles. Maintain month coverage, archive boundaries, role constraints, and symbol state continuity. Return strict JSON only."
  },
  "readiness": {
    "blockers": [
      {
        "code": "EXECUTOR_NOT_VENDORED",
        "detail": "The reviewed TypeScript implementation lives in /Users/yifan/woven/backend and is not a pinned, versioned dependency of this repository."
      },
      {
        "code": "DEEPSEEK_SECRET_MISSING",
        "detail": "A least-privilege Modal secret containing DEEPSEEK_API_KEY must exist before a real generation can run."
      },
      {
        "code": "PRIVATE_DATA_PLANE_MISSING",
        "detail": "Private upload, mode-700 run workspaces, TTL deletion, signed download, and raw-chat deletion need a hosted implementation and tests."
      },
      {
        "code": "COST_INCOMPLETE",
        "detail": "Chromium/Ghostscript compute, Modal resources, storage, egress, retries, and delivered-output yield are not measured."
      },
      {
        "code": "LIVE_FIXTURE_QA_PENDING",
        "detail": "The safe demo fixture must pass the vendored backend suite and one full Modal run before readiness can change."
      }
    ],
    "can_submit": false
  },
  "required_env_names": [
    "DEEPSEEK_API_KEY"
  ],
  "resources": {
    "cpu": 2.0,
    "max_containers": 4,
    "memory_mb": 4096,
    "timeout_seconds": 1200
  },
  "slug": "woven-storybook-pipeline",
  "steps": [
    {"id": "acquire", "operation": "private_artifact.read", "readiness": "blocked", "type": "artifact"},
    {"id": "parse", "operation": "woven.chat.parse_and_locale_gate", "provider": "local", "readiness": "blocked", "type": "native"},
    {"id": "select", "operation": "woven.month_balanced_selection", "provider": "local", "readiness": "blocked", "type": "native"},
    {"id": "essence", "operation": "chat.completions.strict_json", "prompt": "essence.txt", "provider": "deepseek", "readiness": "blocked", "type": "llm"},
    {"id": "plan", "operation": "chat.completions.strict_json", "prompt": "plan.txt", "provider": "deepseek", "readiness": "blocked", "type": "llm"},
    {"id": "chapters", "operation": "chat.completions.concurrent_strict_json", "prompt": "chapter.txt", "provider": "deepseek", "readiness": "blocked", "type": "llm"},
    {"id": "editorial", "operation": "chat.completions.book_audit", "prompt": "editorial.txt", "provider": "deepseek", "readiness": "blocked", "type": "llm"},
    {"id": "gates", "operation": "woven.final_gates", "provider": "local", "readiness": "blocked", "type": "quality"},
    {"id": "render", "operation": "chromium_and_ghostscript.render", "provider": "local", "readiness": "blocked", "type": "native"},
    {"id": "deliver", "operation": "private_artifact.write", "readiness": "blocked", "type": "artifact"}
  ],
  "version": "0.1.0"
