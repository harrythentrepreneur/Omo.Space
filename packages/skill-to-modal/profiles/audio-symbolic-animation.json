  "prompts": {
    "brief.txt": "Create a one-record-per-second frame brief. Every delta must be one visible mechanical event. Preserve anchor identity and fixed geometry, include generation_fps=1 and a verb per frame, and keep the state ledger monotonic. Return strict JSON only.",
    "concept.txt": "Derive one recurring symbol from the transcript and express it as a countable mechanical state machine. Define the invariant anchor, state chain, and identity policy. Do not use mood words as visual deltas. Return strict JSON only.",
    "passage-selection.txt": "When the source exceeds four minutes, select one self-contained passage with a strong opening and clean landing. Use transcript word IDs and timestamps only; never invent or rewrite quotes. Return strict JSON only."
  },
  "readiness": {
    "blockers": [
      {
        "code": "EXECUTOR_NOT_MATERIALIZED",
        "detail": "The referenced Hermes scripts and faster-whisper model are not vendored, pinned, or packaged in this repository."
