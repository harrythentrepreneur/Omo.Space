    {"id": "assemble", "operation": "ffmpeg.delta_only_h264_aac", "provider": "local", "readiness": "blocked", "type": "native"},
    {"id": "qa", "operation": "media_and_vision.validate", "readiness": "blocked", "type": "quality"},
