                "minimum": 0,
                "maximum": 20
              },
              "failed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "tests": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "provider_calls": {
                "const": 0
              },
              "limitations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
