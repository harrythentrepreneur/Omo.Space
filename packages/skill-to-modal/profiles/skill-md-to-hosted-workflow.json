{
  "name": "skill-md-to-hosted-workflow",
  "slug": "skill-md-to-hosted-workflow",
  "version": "1.0.0",
  "execution_kind": "skill_builder",
  "skill_owned_resource": "deterministic_skill_loader_v1",
  "runtime_preference": "modal-hosted",
  "capabilities": [
    "hostile-markdown-parse",
    "reviewed-profile-build",
    "canonical-skill-compiler",
    "fixture-contract-tests",
    "canonical-cost-pricing"
  ],
  "apt_packages": [],
  "artifacts": [],
  "inputs": [
    {
      "name": "skill_md",
      "type": "text/markdown",
      "max_chars": 20000,
      "trust": "hostile-data"
    },
    {
      "name": "options",
      "type": "application/json",
      "trust": "reviewed-contract-hints"
    }
  ],
  "outputs": [
    {
      "name": "build_analysis",
      "type": "application/json",
      "schema_version": "omo.result/v1"
    }
  ],
  "resources": {
    "cpu": 1.0,
    "memory_mb": 1024,
    "timeout_seconds": 180,
    "max_containers": 4
  },
  "required_env_names": [],
  "form": [
    {
      "field": "skill_md",
      "widget": "textarea"
    },
    {
      "field": "name",
      "widget": "text"
    },
    {
      "field": "options",
      "widget": "textarea"
    }
  ],
  "steps": [
    {
      "id": "parse-contract",
      "type": "native",
      "operation": "skill_contract.parse",
      "provider": "local",
      "readiness": "ready"
    },
    {
      "id": "build-profile",
      "type": "native",
      "operation": "reviewed_profile.build",
      "provider": "local",
      "readiness": "ready"
    },
    {
      "id": "compile",
      "type": "native",
      "operation": "skill_to_modal.compile",
      "provider": "local",
      "readiness": "ready"
    },
    {
      "id": "test-fixture",
      "type": "quality",
      "operation": "fixture_contract.test",
      "provider": "local",
      "readiness": "ready"
    },
    {
      "id": "price",
      "type": "native",
      "operation": "canonical_cost.price",
      "provider": "local",
      "readiness": "ready"
    }
  ],
  "prompts": {},
  "pricing": {
    "chargeable": true,
    "default_tier": "loader_build_analysis",
    "estimates": [
      {
        "tier": "loader_build_analysis",
        "guard_cost_usd": 1.0,
        "workflow": {
          "steps": []
        },
        "notes": [
          "The $1.00 service guard covers bounded build analysis, fixture tests, and release handling; canonical 5x markup produces the $5.00 loader price.",
          "Candidate workflow pricing is calculated separately inside each result."
        ]
      }
    ],
    "quote_status": "modeled_service_guard",
    "unpriced_costs": [],
    "notes": [
      "The loader makes zero provider calls and reports zero provider spend.",
      "A blocked candidate still returns typed analysis; payment/refund policy remains owned by the marketplace Worker."
    ]
  },
  "readiness": {
    "can_submit": true,
    "blockers": []
  },
  "cost_drivers": [
    "Bounded Modal CPU and memory for deterministic parsing and compilation",
    "Fixture-level schema and generated-source checks",
    "No provider calls, credentials, network fetch, or generated-candidate deployment"
  ],
  "input_schema": {
    "$id": "https://omo.space/schemas/skill-md-to-hosted-workflow/input.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SKILL.md loader request",
    "description": "One hostile SKILL.md document plus optional explicit machine-readable V1 contract fields.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "skill_md": {
        "type": "string",
        "title": "SKILL.md",
        "description": "Complete Markdown, treated as hostile data and never executed.",
        "minLength": 1,
        "maxLength": 20000,
        "examples": [
          "---\nname: tiny-uppercase-helper\ndescription: Uppercase one supplied string.\n---\n\n## Workflow\n\n1. **Transform:** Return the supplied text in uppercase."
        ]
      },
      "name": {
        "type": "string",
        "title": "Display name",
        "description": "Optional display hint. Source frontmatter remains the candidate identity.",
        "minLength": 1,
        "maxLength": 120
      },
      "options": {
        "type": "object",
        "title": "Explicit V1 contract",
        "description": "Strict schemas, one deterministic fixture, and optional bounded pricing inputs. This may instead be embedded under an Omo V1 contract heading.",
        "additionalProperties": false,
        "properties": {
          "input_schema": {
            "type": "object",
            "maxProperties": 64
          },
          "output_schema": {
            "type": "object",
            "maxProperties": 64
          },
          "fixture": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "input": {
                "type": "object"
              },
              "output": {
                "type": "object"
              }
            },
            "required": [
              "input",
              "output"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "estimated_input_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "max_output_tokens": {
            "type": "integer",
            "minimum": 64,
            "maximum": 8000
          }
        }
      }
    },
    "required": [
      "skill_md"
    ]
  },
  "output_schema": {
