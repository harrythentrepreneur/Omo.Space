              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{2,79}$"
                },
                "stage": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "detail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "resume_point": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "stage",
                "detail",
                "evidence",
                "resume_point",
                "retryable"
              ]
            }
          }
        },
        "required": [
          "status",
          "slug",
          "price_usd",
          "chargeable",
          "manifest",
          "test_summary",
          "blockers"
        ]
      },
      "artifacts": {
        "type": "array",
        "maxItems": 0
      },
      "usage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "adapter": {
            "const": "deterministic-skill-loader@1"
          },
          "provider": {
            "const": "none"
          },
          "model": {
            "const": "none"
          },
          "prompt_tokens": {
            "const": 0
          },
          "completion_tokens": {
            "const": 0
          },
          "provider_calls": {
            "const": 0
          },
          "estimated_cost_usd": {
            "const": 0
