    "properties": {
      "spec_version": {
        "const": "omo.result/v1"
      },
      "run_id": {
        "type": "string",
        "pattern": "^run-[0-9a-f]{32}$"
      },
      "tool_id": {
        "const": "2c2f5f49-95b3-5a33-b80d-603d054c2ae1"
      },
      "tool_version": {
        "const": 1
      },
      "status": {
        "const": "completed"
      },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "ready",
              "blocked"
            ]
          },
          "slug": {
            "type": [
              "string",
              "null"
