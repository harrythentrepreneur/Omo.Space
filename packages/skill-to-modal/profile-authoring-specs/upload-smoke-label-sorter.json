{
  "family": "pure_data",
  "happy_path": {
    "input": {
      "labels": [
        " Stable ",
        "alpha",
        "Beta"
      ]
    },
    "output": {
      "sorted_labels": [
        "alpha",
        "Beta",
        "Stable"
      ],
      "status": "completed"
    }
  },
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "labels": {
        "items": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 12,
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "labels"
    ],
    "type": "object"
  },
  "marketplace": {
    "category": "ops",
    "description": "Deterministically sort a short label list without any AI provider.",
    "emoji": "🔤",
    "inputs": [
      "labels: 1 to 12 strings, each 1 to 60 printable ASCII characters"
    ],
    "niche": "productivity",
    "outputs": [
      "cleaned, deterministically sorted labels"
    ],
    "promise": "Return a deterministic sorted label list.",
    "tags": [
      "text",
      "deterministic"
    ],
    "title": "Upload Smoke Label Sorter"
  },
  "negative_cases": [
    {
      "id": "empty",
      "input": {
        "labels": [
          " "
        ]
      },
      "reason": "INVALID_VALUE"
    }
  ],
  "output_schema": {
    "additionalProperties": false,
    "properties": {
      "sorted_labels": {
        "items": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
        },
        "maxItems": 12,
        "minItems": 1,
        "type": "array"
      },
      "status": {
        "const": "completed"
      }
    },
    "required": [
      "sorted_labels",
      "status"
    ],
    "type": "object"
  },
  "pure_data_program": {
    "limits": {
      "max_input_bytes": 8192,
      "max_list_items": 12,
      "max_output_bytes": 8192,
      "max_steps": 16,
      "max_text_bytes": 60
    },
    "result": "result",
    "spec_version": "omo.pure-data/v1",
    "steps": [
      {
        "id": "labels",
        "op": "input.get",
        "path": "/labels"
      },
      {
        "id": "clean",
        "input": "labels",
        "op": "text_list.normalize_ascii",
        "reject_control_characters": true,
        "reject_empty": true,
        "trim_ascii_whitespace": true
      },
      {
        "id": "sorted",
        "input": "clean",
        "key": "ascii_case_insensitive",
        "op": "text_list.sort_ascii",
        "tie_break": "ascii_bytes"
      },
      {
        "fields": {
          "sorted_labels": {
            "ref": "sorted"
          },
          "status": {
            "const": "completed"
          }
        },
        "id": "result",
        "op": "result.object"
      }
    ]
  },
  "schema_version": "omo.profile-authoring-spec/v2"
}
