app = modal.App(APP_NAME)


@app.function(
    image=runtime_image,
    cpu=1.0,
    memory=1024,
    timeout=180,
    min_containers=0,
    max_containers=4,
    scaledown_window=5,
)
def run_workflow(envelope: dict[str, Any]) -> dict[str, Any]:
    return execute_loader(envelope["input"], run_id=envelope["run_id"])


SpawnRunner = Callable[[dict[str, Any]], str]
LookupResult = Callable[[str], dict[str, Any]]


def create_fastapi_app(
    spawn_runner: SpawnRunner | None = None,
    lookup_result: LookupResult | None = None,
) -> Any:
    from fastapi import Body, FastAPI, Header, HTTPException, Query
    from fastapi.responses import JSONResponse

    web = FastAPI(title="skill-md-to-hosted-workflow", version=PROFILE_VERSION)

    def default_spawn(envelope: dict[str, Any]) -> str:
        return run_workflow.spawn(envelope).object_id

    def default_lookup(call_id: str) -> dict[str, Any]:
        return modal.FunctionCall.from_id(call_id).get(timeout=0)

    spawn = spawn_runner or default_spawn
    lookup = lookup_result or default_lookup

    def require_owner(value: str | None) -> str:
        if value is None:
            raise HTTPException(status_code=401, detail="owner_required")
        try:
            return _owner(value)
        except OwnerScopeError as exc:
            raise HTTPException(status_code=422, detail="owner_invalid") from exc

    def verify_poll_identity(
        run_id: str, call_id: str, access_token: str, owner_header: str | None
    ) -> str:
        owner_id = require_owner(owner_header)
        try:
            if not RUN_RE.fullmatch(run_id) or not CALL_RE.fullmatch(call_id):
                raise OwnerScopeError("RUN_ID_INVALID")
            if run_id != run_id_for(owner_id, access_token):
                raise OwnerScopeError("RUN_OWNER_MISMATCH")
        except OwnerScopeError as exc:
            raise HTTPException(status_code=404, detail="run_not_found") from exc
        return owner_id

    def poll_result(call_id: str, run_id: str) -> Any:
        try:
            result = lookup(call_id)
            validate_instance(result, "output.json")
            if result["run_id"] != run_id:
                raise ValueError("run result identity mismatch")
            return result
        except TimeoutError:
            return JSONResponse(
                {"run_id": run_id, "status": "processing", "phase": "building"},
                status_code=202,
            )
        except Exception:
            return JSONResponse(
                {"run_id": run_id, "status": "failed", "error": {"code": "RUN_FAILED"}},
                status_code=500,
            )

    @web.post("/v1/runs", status_code=202)
    async def submit(
        body: Any = Body(...),
        x_omo_owner_id: str | None = Header(default=None, alias="X-Omo-Owner-Id"),
    ) -> Any:
        owner_id = require_owner(x_omo_owner_id)
        try:
            validate_instance(body, "input.json")
        except ValidationError as exc:
            raise HTTPException(status_code=422, detail=exc.message) from exc
        access_token = secrets.token_urlsafe(32)
        run_id = run_id_for(owner_id, access_token)
        call_id = spawn({"input": body, "owner_id": owner_id, "run_id": run_id})
        return {
            "run_id": run_id,
            "call_id": call_id,
            "status": "accepted",
            "phase": "queued",
            "progress_pct": 0,
            "status_url": f"/v1/runs/{run_id}/status?call_id={call_id}&access_token={access_token}",
            "result_url": f"/v1/runs/{run_id}?call_id={call_id}&access_token={access_token}",
            "separate_result_url": f"/v1/runs/{run_id}/result?call_id={call_id}&access_token={access_token}",
        }

    @web.get("/v1/runs/{run_id}")
    async def get_result(
        run_id: str,
        call_id: str = Query(..., min_length=4, max_length=200),
        access_token: str = Query(..., min_length=32, max_length=200),
        x_omo_owner_id: str | None = Header(default=None, alias="X-Omo-Owner-Id"),
    ) -> Any:
        verify_poll_identity(run_id, call_id, access_token, x_omo_owner_id)
        return poll_result(call_id, run_id)

    @web.get("/v1/runs/{run_id}/status")
    async def get_status(
        run_id: str,
        call_id: str = Query(..., min_length=4, max_length=200),
        access_token: str = Query(..., min_length=32, max_length=200),
        x_omo_owner_id: str | None = Header(default=None, alias="X-Omo-Owner-Id"),
    ) -> Any:
        verify_poll_identity(run_id, call_id, access_token, x_omo_owner_id)
        response = poll_result(call_id, run_id)
        if isinstance(response, JSONResponse):
            return response
        return {
            "run_id": run_id,
            "status": "completed",
            "phase": "delivered",
            "result_url": f"/v1/runs/{run_id}/result?call_id={call_id}&access_token={access_token}",
        }

    @web.get("/v1/runs/{run_id}/result")
    async def get_separate_result(
        run_id: str,
        call_id: str = Query(..., min_length=4, max_length=200),
        access_token: str = Query(..., min_length=32, max_length=200),
        x_omo_owner_id: str | None = Header(default=None, alias="X-Omo-Owner-Id"),
    ) -> Any:
        verify_poll_identity(run_id, call_id, access_token, x_omo_owner_id)
        return poll_result(call_id, run_id)

    return web


@app.function(
    image=runtime_image,
    min_containers=0,
    max_containers=20,
    scaledown_window=2,
)
@modal.concurrent(max_inputs=20)
@modal.asgi_app(requires_proxy_auth=True)
def api() -> Any:
    return create_fastapi_app()
