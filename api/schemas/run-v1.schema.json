{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognition.local/schemas/run-v1.schema.json",
  "type": "object",
  "required": ["contract_version", "id", "workflow", "status", "created_at", "updated_at", "result", "artifacts", "error"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^run_[A-Za-z0-9]+$" },
    "workflow": {
      "type": "object",
      "required": ["slug", "version"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "status": { "enum": ["queued", "running", "succeeded", "failed"] },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "result": {
      "anyOf": [
        { "type": "null" },
        { "type": "object" }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "artifact-v1.schema.json" }
    },
    "error": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message", "retryable", "issues"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "code", "message"],
                "additionalProperties": false,
                "properties": {
                  "path": { "type": "string" },
                  "code": { "type": "string", "minLength": 1 },
                  "message": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
