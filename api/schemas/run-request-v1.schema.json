{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognition.local/schemas/run-request-v1.schema.json",
  "type": "object",
  "required": ["contract_version", "workflow", "input"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "const": "1.0" },
    "workflow": {
      "type": "object",
      "required": ["slug"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "input": { "type": "object" }
  }
}
