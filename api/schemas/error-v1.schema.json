{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognition.local/schemas/error-v1.schema.json",
  "type": "object",
  "required": ["error"],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": ["contract_version", "code", "message", "retryable", "issues"],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "const": "1.0" },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "code", "message"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
