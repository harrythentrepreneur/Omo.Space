{
  "chargeable": true,
  "container_slug": "woven-storybook-pipeline",
  "examples": [
    {
      "caption": "Warm · short keepsake",
      "id": "rainy-bookshop",
      "input": {
        "favorite_moments": "Seven years, two cities, our first tiny apartment, and adopting a corgi who steals socks.",
        "how_you_met": "We met after reaching for the same travel book in a rainy bookshop, then talked until closing.",
        "inside_jokes": "We say ‘wrong turn, best view’ whenever a plan goes sideways, and call burnt breakfast the smoke-alarm serenade.",
        "length": "short",
        "style": "warm"
      },
      "output_preview": "A warm three-chapter keepsake with a PDF-ready page plan.",
      "title": "The rainy bookshop"
    }
  ],
  "input_schema": {
    "$id": "https://cognition.marketplace/schemas/woven-storybook-pipeline/input.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "The safe hosted preview accepts story facts directly. The full WhatsApp archive/PDF pipeline remains private and is not this runtime scope.",
    "properties": {
      "favorite_moments": {
        "description": "Milestones and memories the story should include.",
        "examples": [
          "Seven years, two cities, our first apartment, and adopting a corgi who steals socks."
        ],
        "maxLength": 2400,
        "minLength": 12,
        "title": "Favorite moments",
        "type": "string"
      },
      "how_you_met": {
        "description": "A factual account of the beginning of the relationship.",
        "examples": [
          "We met after reaching for the same travel book in a rainy bookshop."
        ],
        "maxLength": 1200,
        "minLength": 12,
        "title": "How you met",
        "type": "string"
      },
      "inside_jokes": {
        "description": "Favorite phrases, jokes, or small details to weave in without inventing new facts.",
        "examples": [
          "‘Wrong turn, best view’ and our corgi’s habit of stealing socks."
        ],
        "maxLength": 1200,
        "minLength": 3,
        "title": "Inside jokes and tiny details",
        "type": "string"
      },
      "length": {
        "default": "short",
        "description": "Short is roughly three chapters; long is roughly six.",
        "enum": [
          "short",
          "long"
        ],
        "title": "Story length",
        "type": "string"
      },
      "style": {
        "default": "warm",
        "description": "The writing style; facts remain unchanged.",
        "enum": [
          "warm",
          "playful",
          "poetic"
        ],
        "title": "Writing style",
        "type": "string"
      }
    },
    "required": [
      "how_you_met",
      "favorite_moments",
      "inside_jokes",
      "style",
      "length"
    ],
    "title": "Woven keepsake drafting preview",
    "type": "object"
  },
  "input_schema_source": "containers/woven-storybook-pipeline/schemas/input.json",
  "output_schema": {
    "$id": "https://cognition.marketplace/schemas/woven-storybook-pipeline/output.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "book": {
        "description": "The generated chaptered keepsake in Markdown.",
        "maxLength": 12000,
        "minLength": 240,
        "title": "Keepsake story",
        "type": "string"
      },
      "page_plan": {
        "description": "A PDF-ready sequence of page or spread notes.",
        "items": {
          "maxLength": 360,
          "minLength": 8,
          "type": "string"
        },
        "maxItems": 14,
        "minItems": 4,
        "title": "Page plan",
        "type": "array"
      },
      "run_id": {
        "minLength": 8,
        "title": "Run ID",
        "type": "string"
      },
      "status": {
        "const": "completed"
      },
      "title": {
        "maxLength": 120,
        "minLength": 3,
        "title": "Book title",
        "type": "string"
      },
      "usage": {
        "additionalProperties": false,
        "properties": {
          "completion_tokens": {
            "minimum": 0,
            "type": "integer"
          },
          "estimated_cost_usd": {
            "minimum": 0,
            "type": "number"
          },
          "llm_calls": {
            "const": 1
          },
          "model": {
            "minLength": 1,
            "type": "string"
          },
          "prompt_tokens": {
            "minimum": 0,
            "type": "integer"
          },
          "provider": {
            "const": "opencode-go"
          }
        },
        "required": [
          "provider",
          "model",
          "llm_calls",
          "prompt_tokens",
          "completion_tokens",
          "estimated_cost_usd"
        ],
        "title": "Provider usage",
        "type": "object"
      },
      "workflow_version": {
        "const": "woven-storybook-pipeline@0.2.0"
      }
    },
    "required": [
      "run_id",
      "status",
      "workflow_version",
      "title",
      "book",
      "page_plan",
      "usage"
    ],
    "title": "Completed Woven drafting preview",
    "type": "object"
  },
  "output_schema_source": "containers/woven-storybook-pipeline/schemas/output.json",
  "phases": [
    {
      "id": "running",
      "label": "Writing and polishing your story"
    },
    {
      "id": "delivered",
      "label": "Delivered"
    }
  ],
  "price_usd": 0.4,
  "ready": true,
  "schema_version": "omo.run-manifest/v1",
  "slug": "woven-relationship-book-maker",
  "ui": {
    "fields": {
      "favorite_moments": {
        "widget": "textarea"
      },
      "how_you_met": {
        "widget": "textarea"
      },
      "inside_jokes": {
        "widget": "textarea"
      },
      "length": {
        "widget": "select"
      },
      "style": {
        "widget": "select"
      }
    },
    "order": [
      "how_you_met",
      "favorite_moments",
      "inside_jokes",
      "style",
      "length"
    ]
  }
}
